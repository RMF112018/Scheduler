# Staging Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/scheduler_staging
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=your_staging_password
POSTGRES_DB=scheduler_staging

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-staging-jwt-secret-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-staging-refresh-secret-key-change-this
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@scheduler.com

# Azure Storage (for attachments)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Module Flags
ENABLE_COST_MODULE=false
ENABLE_DOCS_MODULE=false
ENABLE_RFI_MODULE=false

# Webhook Configuration
PARTNER_WEBHOOKS=false
WEBHOOK_SECRET=your-webhook-secret-key
